{
  "name": "wiz_app",
  "productName": "WiZ APP",
  "version": "4.0.0-beta.3",
  "description": "💡 Simple desktop app to connect and control WiZ Bulbs",
  "author": {
    "name": "MatiasTK",
    "email": "matiavallejo@gmail.com"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/MatiasTK/WizAPP",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-signed.ps1",
    "build:web": "npm run typecheck && vite build",
    "build:unsigned": "tauri build --bundles nsis --config \"{\\\"bundle\\\":{\\\"createUpdaterArtifacts\\\":false}}\"",
    "start": "cargo run --release --features tauri/custom-protocol --manifest-path src-tauri/Cargo.toml",
    "test": "pnpm test:web && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run",
    "check:contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx",
    "format": "prettier --write .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "clsx": "^2.1.1",
    "i18next": "^25.7.4",
    "react": "^19.2.3",
    "react-i18next": "^16.5.3",
    "react-icons": "^5.5.0",
    "react-router": "^7.12.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.8.0",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
