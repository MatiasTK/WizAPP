{
  "name": "wiz_app",
  "productName": "WiZ APP",
  "version": "4.0.0-beta.1",
  "description": "💡 Simple desktop app to connect and control WiZ Bulbs",
  "author": {
    "name": "MatiasTK",
    "email": "matiavallejo@gmail.com"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/MatiasTK/WizAPP",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "npm run typecheck && vite build",
    "build:unsigned": "tauri build --bundles nsis --config \"{\\\"bundle\\\":{\\\"createUpdaterArtifacts\\\":false}}\"",
    "start": "cargo run --release --features tauri/custom-protocol --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx",
    "format": "prettier --write .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "i18next": "^25.7.4",
    "react": "^19.2.3",
    "react-i18next": "^16.5.3",
    "react-icons": "^5.5.0",
    "react-router": "^7.12.0",
    "tailwind-animations": "^1.0.1",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.10",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.8.0",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "@tauri-apps/cli": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-config-prettier": "^10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
